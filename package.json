      "browserslist@<=4.28.6": "4.28.7",
      "@babel/core@>=7.0.0 <7.29.6": "7.29.6",
      "@next/eslint-plugin-next@16.3.8>fast-glob": "npm:tinyglobby@0.2.17"
    },
    "patchedDependencies": {
      "@next/eslint-plugin-next@16.3.8": "patches/@next__eslint-plugin-next@16.3.8.patch"
    }
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@tanstack/react-query": "^5.101.0",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^2.0.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.29.2",
    "lucide-react": "^1.14.0",
    "next": "16.3.8",
    "nuqs": "^2.8.9",
    "radix-ui": "^1.6.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.71.1",
    "swiper": "^12.1.2",
    "tailwind-merge": "^3.4.0",
    "three": "^0.176.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "20.19.43",
    "@types/react": "19.2.10",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.182.0",
    "autoprefixer": "10.4.23",
    "eslint": "9.39.2",
