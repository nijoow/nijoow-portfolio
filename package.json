    "eslint-plugin-sonarjs": "^4.2.0",
    "jsdom": "^29.1.1",
    "postcss": "8.5.23",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "tailwindcss": "4.1.18",
    "typescript": "5.9.3",
    "typescript-eslint": "8.54.0",
    "vitest": "^4.1.11"
