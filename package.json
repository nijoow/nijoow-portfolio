{
  "name": "nijoow-portfolio",
  "homepage": "https://nijoow-portfolio.vercel.app",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check src package.json eslint.config.mjs vitest.config.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm format:check"
  },
  "packageManager": "pnpm@9.15.3",
